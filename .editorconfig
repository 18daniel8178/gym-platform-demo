# EditorConfig — estilo de código consistente entre editores. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: los espacios finales pueden ser saltos de línea intencionales
[*.md]
trim_trailing_whitespace = false

# Makefiles / scripts que requieren tabs
[Makefile]
indent_style = tab
